# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# basis data SQLite & backup
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/backup/

# hasil test
/test-results/
/playwright-report/

# izinkan contoh env ikut ter-commit
!.env.example

# Penyesuaian compose khas satu mesin: binding porta, jaringan, batas memori.
# Sengaja tidak ikut ter-commit karena isinya berbeda di tiap host -- server
# produksi memetakan 127.0.0.1:8091 sebab seluruh domain masuk lewat satu
# cloudflared di host, bukan porta publik.
#
# Berkas ini TIDAK TERGANTIKAN dan hanya ada di mesin bersangkutan. Tanpa baris
# ini statusnya untracked tanpa perlindungan apa pun: `git clean -fd` akan
# menghapusnya, dan checkout ke branch yang kebetulan memuat berkas bernama
# sama akan ditolak di tengah jalan. Cadangkan sebelum operasi git besar.
docker-compose.override.yml

# Kunci penandatanganan APK — jangan pernah masuk repositori.
android/*.keystore
android/*.jks
android/app-release-*.apk
android/app-release-*.aab

# Proyek Android hasil generate bubblewrap (sekali pakai)
android/build/
