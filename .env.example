# Basis data SQLite; jalurnya relatif terhadap folder prisma/
DATABASE_URL="file:../data/cuan.db"

# Alamat publik aplikasi, dipakai Auth.js saat membuat tautan
NEXTAUTH_URL="http://localhost:3000"

# Rahasia penandatangan sesi. Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"
NEXTAUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"

# Percaya header Host dari proksi (Cloudflare Tunnel, Nginx, Traefik)
AUTH_TRUST_HOST="true"

# Token untuk memanggil /api/cron/berulang dari penjadwal sistem.
# Buat dengan: openssl rand -base64 32
CRON_SECRET=""

# Token Cloudflare Tunnel; hanya dipakai profil "tunnel" pada docker compose
TUNNEL_TOKEN=""

# Folder tujuan npm run db:backup
BACKUP_DIR="./backup"

# --------------------------- Pembungkus Android (TWA) ---------------------------
# Mengisi /.well-known/assetlinks.json. Selama salah satu kosong, berkas itu
# menjawab "[]" dan Android menampilkan bilah alamat Chrome di atas aplikasi.
# Sidik jari diambil dari keystore penandatangan:
#   keytool -list -v -keystore android/cuan.keystore -alias cuan | grep SHA256:
# Boleh diisi beberapa sidik jari dipisah koma -- diperlukan bila Play Store
# memakai penandatanganan terkelola dan menandatangani ulang dengan kuncinya.
TWA_PACKAGE_NAME=""
TWA_SHA256_FINGERPRINT=""

# Password untuk akun contoh dari npm run db:seed (opsional, minimal 8 karakter)
# SEED_PASSWORD=""
